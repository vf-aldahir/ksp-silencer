; ==================== SITIOS DE CONFIANZA ====================
; Agrega tunnel.googlezip.net como sitio confiable para que
; Kaspersky deje de inspeccionarlo y no genere el popup de
; certificado. Este dominio es legitimo — es el prefetch proxy
; de Google Chrome.
[HKEY_LOCAL_MACHINE\SOFTWARE\KasperskyLab\KES\settings\WebProtection\TrustedURLs]
"tunnel.googlezip.net"="tunnel.googlezip.net"

[HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\KasperskyLab\KES\settings\WebProtection\TrustedURLs]
"tunnel.googlezip.net"="tunnel.googlezip.net"

[HKEY_LOCAL_MACHINE\SOFTWARE\KasperskyLab\AVP\settings\WebProtection\TrustedURLs]
"tunnel.googlezip.net"="tunnel.googlezip.net"

[HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\KasperskyLab\AVP\settings\WebProtection\TrustedURLs]
"tunnel.googlezip.net"="tunnel.googlezip.net"

[HKEY_CURRENT_USER\SOFTWARE\KasperskyLab\KES\settings\WebProtection\TrustedURLs]
"tunnel.googlezip.net"="tunnel.googlezip.net"

[HKEY_CURRENT_USER\SOFTWARE\KasperskyLab\AVP\settings\WebProtection\TrustedURLs]
"tunnel.googlezip.net"="tunnel.googlezip.net"

; Exclusiones globales de inspeccion SSL
[HKEY_LOCAL_MACHINE\SOFTWARE\KasperskyLab\KES\settings\WebProtection\SSLExclusions]
"tunnel.googlezip.net"="tunnel.googlezip.net"

[HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\KasperskyLab\KES\settings\WebProtection\SSLExclusions]
"tunnel.googlezip.net"="tunnel.googlezip.net"

[HKEY_LOCAL_MACHINE\SOFTWARE\KasperskyLab\AVP\settings\WebProtection\SSLExclusions]
"tunnel.googlezip.net"="tunnel.googlezip.net"

[HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\KasperskyLab\AVP\settings\WebProtection\SSLExclusions]
"tunnel.googlezip.net"="tunnel.googlezip.net"

[HKEY_CURRENT_USER\SOFTWARE\KasperskyLab\KES\settings\WebProtection\SSLExclusions]
"tunnel.googlezip.net"="tunnel.googlezip.net"

[HKEY_CURRENT_USER\SOFTWARE\KasperskyLab\AVP\settings\WebProtection\SSLExclusions]
"tunnel.googlezip.net"="tunnel.googlezip.net"

; ==================== INSPECCION SSL - DESACTIVAR COMPLETAMENTE ====================
; Kaspersky intercepta todo el trafico HTTPS para inspeccionarlo.
; Al desactivarlo, ya no puede ver certificados y el popup desaparece.
; La proteccion de archivos en tiempo real sigue funcionando.
[HKEY_LOCAL_MACHINE\SOFTWARE\KasperskyLab\KES\settings\WebProtection]
"EnableSSLScan"=dword:00000000
"EnableHTTPSScan"=dword:00000000
"ScanEncryptedConnections"=dword:00000000
"CheckSSLCertificates"=dword:00000000
"EnableCertificateCheck"=dword:00000000
"InterceptSSL"=dword:00000000
"ScanHTTPS"=dword:00000000
"EnableEncryptedTrafficScan"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\KasperskyLab\KES\settings\WebProtection]
"EnableSSLScan"=dword:00000000
"EnableHTTPSScan"=dword:00000000
"ScanEncryptedConnections"=dword:00000000
"CheckSSLCertificates"=dword:00000000
"EnableCertificateCheck"=dword:00000000
"InterceptSSL"=dword:00000000
"ScanHTTPS"=dword:00000000
"EnableEncryptedTrafficScan"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\KasperskyLab\AVP\settings\WebProtection]
"EnableSSLScan"=dword:00000000
"EnableHTTPSScan"=dword:00000000
"ScanEncryptedConnections"=dword:00000000
"CheckSSLCertificates"=dword:00000000
"EnableCertificateCheck"=dword:00000000
"InterceptSSL"=dword:00000000
"ScanHTTPS"=dword:00000000
"EnableEncryptedTrafficScan"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\KasperskyLab\AVP\settings\WebProtection]
"EnableSSLScan"=dword:00000000
"EnableHTTPSScan"=dword:00000000
"ScanEncryptedConnections"=dword:00000000
"CheckSSLCertificates"=dword:00000000
"InterceptSSL"=dword:00000000
"ScanHTTPS"=dword:00000000

[HKEY_CURRENT_USER\SOFTWARE\KasperskyLab\KES\settings\WebProtection]
"EnableSSLScan"=dword:00000000
"EnableHTTPSScan"=dword:00000000
"ScanEncryptedConnections"=dword:00000000
"CheckSSLCertificates"=dword:00000000
"InterceptSSL"=dword:00000000

[HKEY_CURRENT_USER\SOFTWARE\KasperskyLab\AVP\settings\WebProtection]
"EnableSSLScan"=dword:00000000
"EnableHTTPSScan"=dword:00000000
"ScanEncryptedConnections"=dword:00000000
"CheckSSLCertificates"=dword:00000000
"InterceptSSL"=dword:00000000

; ==================== PROTECCION WEB - DESACTIVAR MODULO ====================
; Apaga el modulo completo que inspecciona el navegador.
; La proteccion de archivos y sistema sigue activa.
[HKEY_LOCAL_MACHINE\SOFTWARE\KasperskyLab\KES\settings\WebAV]
"EnableWebAV"=dword:00000000
"Enabled"=dword:00000000
"ShowPopups"=dword:00000000
"EnableNotifications"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\KasperskyLab\KES\settings\WebAV]
"EnableWebAV"=dword:00000000
"Enabled"=dword:00000000
"ShowPopups"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\KasperskyLab\AVP\settings\WebAV]
"EnableWebAV"=dword:00000000
"Enabled"=dword:00000000
"ShowPopups"=dword:00000000
"EnableNotifications"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\KasperskyLab\AVP\settings\WebAV]
"EnableWebAV"=dword:00000000
"Enabled"=dword:00000000

[HKEY_CURRENT_USER\SOFTWARE\KasperskyLab\KES\settings\WebAV]
"EnableWebAV"=dword:00000000
"Enabled"=dword:00000000
"ShowPopups"=dword:00000000

[HKEY_CURRENT_USER\SOFTWARE\KasperskyLab\AVP\settings\WebAV]
"EnableWebAV"=dword:00000000
"Enabled"=dword:00000000

