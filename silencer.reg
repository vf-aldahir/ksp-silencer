; ==================== FIREWALL - NOTIFICACIONES DE RED ====================
; Desactiva "Notificar al conectarse a red" en el Firewall de Kaspersky.
; Esto silencia los popups de dispositivos nuevos en Ethernet y Wi-Fi
; que persisten aunque se desactiven otras notificaciones.
[HKEY_LOCAL_MACHINE\SOFTWARE\KasperskyLab\KES\settings\Firewall]
"NotifyOnNetworkChange"=dword:00000000
"NotifyOnNewNetwork"=dword:00000000
"NotifyOnConnectionToNetwork"=dword:00000000
"ShowNetworkStatusPopup"=dword:00000000
"EnableNetworkAlerts"=dword:00000000
"NotifyNewDeviceConnected"=dword:00000000

