Windows Registry Editor Version 5.00

; ============================================================
;  KASPERSKY - SILENCIO TOTAL AGRESIVO
;  Cubre KES 10 / 11 / 12, KAV, KIS, KTS, KSOS
;  32-bit y 64-bit
; ============================================================

; ==================== KES - HKLM 64bit ====================
[HKEY_LOCAL_MACHINE\SOFTWARE\KasperskyLab\KES\settings]
"SilentMode"=dword:00000001
"InteractiveMode"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\KasperskyLab\KES\settings\Notifications]
"EnableNotifications"=dword:00000000
"ShowPopups"=dword:00000000
"EnableSoundNotifications"=dword:00000000
"ShowToastNotifications"=dword:00000000
"EnableProductNotifications"=dword:00000000
"EnableAdvertisingNotifications"=dword:00000000
"EnableNewsNotifications"=dword:00000000
"EnableCriticalNotifications"=dword:00000000
"EnableWarningNotifications"=dword:00000000
"EnableInfoNotifications"=dword:00000000
"ShowUpdateNotifications"=dword:00000000
"ShowLicenseNotifications"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\KasperskyLab\KES\settings\Interface]
"ShowSystemTray"=dword:00000001
"ShowBalloonNotifications"=dword:00000000
"ShowWindowOnStart"=dword:00000000
"DoNotDisturb"=dword:00000001
"ShowSplashScreen"=dword:00000000
"ShowMainWindow"=dword:00000000
"AutostartGUI"=dword:00000000

