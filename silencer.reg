; ==================== BLOQUEO DE GUI EN AUTORUN ====================
; Evita que avpui.exe arranque con Windows
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Run]
"Kaspersky UI"=-
"AVP"=-
"AVPUI"=-

[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\Run]
"Kaspersky UI"=-
"AVP"=-
"AVPUI"=-

; ==================== NOTIFICACIONES DE WINDOWS (Action Center) ====================
[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\Notifications\Settings\Kaspersky.KasperskyEndpointSecurity]
"Enabled"=dword:00000000
"ShowInActionCenter"=dword:00000000

[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\Notifications\Settings\Kaspersky.KasperskyAntiVirus]
"Enabled"=dword:00000000
"ShowInActionCenter"=dword:00000000

[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\Notifications\Settings\Kaspersky.KasperskyInternetSecurity]
"Enabled"=dword:00000000
"ShowInActionCenter"=dword:00000000

[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\Notifications\Settings\Kaspersky.KasperskyTotalSecurity]
"Enabled"=dword:00000000
"ShowInActionCenter"=dword:00000000

