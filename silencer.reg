Windows Registry Editor Version 5.00


; ==================== PROTECCION DE IDENTIDAD / DATA LEAK ====================
; Silencia los popups de "no se filtraron datos" y verificacion de cuentas
[HKEY_LOCAL_MACHINE\SOFTWARE\KasperskyLab\KES\settings\IdentityProtection]
"EnableNotifications"=dword:00000000
"ShowPopups"=dword:00000000
"EnableDataLeakNotifications"=dword:00000000
"ShowAccountCheckNotifications"=dword:00000000
"EnableDarkWebNotifications"=dword:00000000

