; ============================================================
;  KSP SILENCER - silencer.reg
;  Version : 6
;  Cubre   : KES 10/11/12, KAV, KIS, KTS, KSOS, Premium
;            32-bit y 64-bit
;
;  Silencia TODAS las notificaciones incluyendo:
;    - Popups generales
;    - Alertas de red y certificados
;    - Alertas de dispositivos nuevos en Wi-Fi
;    - Notificaciones de productos y publicidad
;    - Sonidos
;    - Action Center de Windows
;    - Autoarranque de la GUI
;
;  Desarrollado por Daniel Medero y Aldahir Sanchez
;  TI - Colegio Viktor Frankl, Queretaro
; ============================================================

; ==================== MARCA DE VERSION ====================
; El script de PowerShell lee este valor para saber si el
; equipo tiene la version mas reciente aplicada.
; Al actualizar el .reg, incrementar este numero.
[HKEY_LOCAL_MACHINE\SOFTWARE\KspSilencer]
"RegVersion"=dword:00000006

; ==================== KES 64bit - GENERAL ====================
[HKEY_LOCAL_MACHINE\SOFTWARE\KasperskyLab\KES\settings]
"SilentMode"=dword:00000001
"InteractiveMode"=dword:00000000
"EnableInteractiveMode"=dword:00000000

; ==================== KES 64bit - NOTIFICACIONES ====================
[HKEY_LOCAL_MACHINE\SOFTWARE\KasperskyLab\KES\settings\Notifications]
"EnableNotifications"=dword:00000000
"ShowPopups"=dword:00000000
"EnableSoundNotifications"=dword:00000000
"ShowToastNotifications"=dword:00000000
"EnableProductNotifications"=dword:00000000
"EnableAdvertisingNotifications"=dword:00000000
